# Copy this to .env and fill in your own values. .env is gitignored.

# Desktop toast notifications on Windows. No setup needed.
NOTIFY_DESKTOP=true

# Email alerts. Leave blank to disable (the scanner still prints to the console).
#
# Gmail needs an APP PASSWORD, not your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_TO=

# Defaults are for Gmail. Outlook: smtp-mail.outlook.com / 587.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587

# Optional Tradovate DEMO credentials for the tradebot adapter. The futures system does
# not read this file itself; load these into the process environment with your preferred
# local secret manager. Leave blank to keep the adapter disabled.
TRADOVATE_DEMO_NAME=
TRADOVATE_DEMO_PASSWORD=
TRADOVATE_DEMO_APP_ID=tradebot
TRADOVATE_DEMO_APP_VERSION=0.2.0
TRADOVATE_DEMO_CID=
TRADOVATE_DEMO_SEC=
TRADOVATE_DEMO_DEVICE_ID=
TRADOVATE_DEMO_ACCOUNT_ID=
TRADOVATE_DEMO_ACCOUNT_SPEC=

# LIVE credentials are intentionally omitted. The included adapter hard-refuses the live
# host, and Tradeify Evaluation/Sim-Funded accounts do not expose Tradovate API access.
