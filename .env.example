# Copy this to .env and fill in your own values. .env is gitignored.

# Desktop toast notifications on Windows. No setup needed.
NOTIFY_DESKTOP=true

# Email alerts. Leave blank to disable (the scanner still prints to the console).
#
# Gmail needs an APP PASSWORD, not your normal password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
NOTIFY_EMAIL_USER=
NOTIFY_EMAIL_PASSWORD=
NOTIFY_EMAIL_TO=

# Defaults are for Gmail. Outlook: smtp-mail.outlook.com / 587.
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
